# Copy to server/.env and fill in. Never commit .env.

# MongoDB Atlas connection string. Put the database name before the "?".
# Example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/luna-cafe?retryWrites=true&w=majority
MONGODB_URI=

PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# At least 32 random characters. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Used only by "npm run seed" to create the admin account once.
ADMIN_EMAIL=admin@lunacafe.local
ADMIN_PASSWORD=

# Booking and event emails (optional). Sent through Brevo's HTTP API (Render's free plan blocks SMTP).
# Without BREVO_API_KEY and MAIL_FROM_ADDRESS nothing is sent; the server just logs that it would have.
# MAIL_FROM_ADDRESS must be a sender verified in Brevo.
BREVO_API_KEY=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Luna Café
# MAIL_REPLY_TO=
# Staff get an email for every new booking and event sign-up (comma-separated for several people).
# ADMIN_NOTIFY_EMAIL=
SITE_URL=https://lunaacafe.vercel.app
