# Copy to e2e/.env for running the end-to-end tests locally (npm run e2e).
# Never point this at the live database: the tests seed it and add bookings and messages.

# Same Atlas cluster is fine, but use a separate database name (here: luna-cafe-e2e).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/luna-cafe-e2e?retryWrites=true&w=majority

# Any values: the seed creates this admin in the test database.
ADMIN_EMAIL=admin@lunacafe.local
ADMIN_PASSWORD=e2e-admin-passphrase
JWT_SECRET=local-e2e-secret-that-is-at-least-32-characters
